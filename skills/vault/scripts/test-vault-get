#!/usr/bin/env bash
# Synthetic tests for vault-get — no real Vault calls.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VAULT_GET="${SCRIPT_DIR}/vault-get"
PASS=0; FAIL=0; TOTAL=0

# ---------------------------------------------------------------------------
# Fixture: fake Vault KV v2 response
# ---------------------------------------------------------------------------
FIXTURE=$(mktemp "${TMPDIR:-/tmp}/vault-fixture-XXXXXX.json")
cat > "$FIXTURE" <<'JSON'
{
  "data": {
    "data": {
      "client_id": "abc123def456",
      "client_secret": "s3cr3t-VERY-long-value-that-should-be-hidden-9876",
      "api_url": "https://api.example.com/v1"
    },
    "metadata": {
      "created_time": "2025-01-15T10:00:00Z",
      "version": 3,
      "destroyed": false
    }
  }
}
JSON

cleanup() { rm -f "$FIXTURE" "$TMPFILE" "$WRITE_ENV" "$WRITE_JSON" 2>/dev/null; }
trap cleanup EXIT

assert() {
  TOTAL=$((TOTAL + 1))
  local name="$1" expected="$2" actual="$3"
  if [ "$expected" = "$actual" ]; then
    echo "  ✓ $name"
    PASS=$((PASS + 1))
  else
    echo "  ✗ $name"
    echo "    expected: $expected"
    echo "    actual:   $actual"
    FAIL=$((FAIL + 1))
  fi
}

assert_contains() {
  TOTAL=$((TOTAL + 1))
  local name="$1" needle="$2" haystack="$3"
  if printf '%s' "$haystack" | grep -qF "$needle"; then
    echo "  ✓ $name"
    PASS=$((PASS + 1))
  else
    echo "  ✗ $name"
    echo "    expected to contain: $needle"
    echo "    in: $haystack"
    FAIL=$((FAIL + 1))
  fi
}

assert_not_contains() {
  TOTAL=$((TOTAL + 1))
  local name="$1" needle="$2" haystack="$3"
  if ! printf '%s' "$haystack" | grep -qF "$needle"; then
    echo "  ✓ $name"
    PASS=$((PASS + 1))
  else
    echo "  ✗ $name"
    echo "    expected NOT to contain: $needle"
    echo "    in: $haystack"
    FAIL=$((FAIL + 1))
  fi
}

# ===========================================================================
echo "=== 1. Masked mode (default) ==="
# ===========================================================================
OUT=$("$VAULT_GET" customer/ciam/stg/qas-us/Application_Credentials/my_app --fixture "$FIXTURE" --masked 2>&1)
assert_contains "shows client_id field name" "client_id" "$OUT"
assert_contains "shows client_secret field name" "client_secret" "$OUT"
assert_contains "shows char count for client_id" "12 chars" "$OUT"
assert_contains "shows sha256 fingerprint prefix" "sha256:" "$OUT"
# Safety: no raw secret values in stdout
assert_not_contains "no raw client_secret in stdout" "s3cr3t-VERY-long-value-that-should-be-hidden-9876" "$OUT"
assert_not_contains "no raw client_id in stdout" "abc123def456" "$OUT"
assert_contains "masked client_id shows first4…last4" "abc1…f456" "$OUT"
assert_contains "masked client_secret shows first4…last4" "s3cr…9876" "$OUT"

# ===========================================================================
echo ""
echo "=== 2. Masked mode with --field ==="
# ===========================================================================
OUT=$("$VAULT_GET" customer/ciam/stg/qas-us/Application_Credentials/my_app --fixture "$FIXTURE" --field client_id 2>&1)
assert_contains "shows client_id" "client_id" "$OUT"
assert_not_contains "does NOT show client_secret" "client_secret" "$OUT"

# ===========================================================================
echo ""
echo "=== 3. Clipboard mode — stdout confirmation only ==="
# ===========================================================================
# We can't test actual pbcopy content, but we test stdout output
# Create a mock pbcopy that just eats stdin
MOCK_BIN=$(mktemp -d "${TMPDIR:-/tmp}/mock-bin-XXXXXX")
cat > "$MOCK_BIN/pbcopy" <<'SH'
#!/usr/bin/env bash
cat > /dev/null
SH
chmod +x "$MOCK_BIN/pbcopy"
OUT=$(PATH="$MOCK_BIN:$PATH" "$VAULT_GET" customer/ciam/stg/qas-us/Application_Credentials/my_app \
  --fixture "$FIXTURE" --clipboard client_secret 2>&1)
assert_contains "clipboard prints confirmation" "copied client_secret" "$OUT"
assert_contains "clipboard shows char count" "49 chars" "$OUT"
assert_not_contains "no raw secret in clipboard stdout" "s3cr3t-VERY" "$OUT"
rm -rf "$MOCK_BIN"

# ===========================================================================
echo ""
echo "=== 4. Write mode — env format ==="
# ===========================================================================
WRITE_ENV=$(mktemp "${TMPDIR:-/tmp}/vault-write-XXXXXX.env")
rm -f "$WRITE_ENV"  # let vault-get create it
OUT=$("$VAULT_GET" customer/ciam/stg/qas-us/Application_Credentials/my_app \
  --fixture "$FIXTURE" --write "$WRITE_ENV" --format env 2>&1)
assert_contains "write prints confirmation" "wrote 3 keys to" "$OUT"
assert_not_contains "no raw secret in write stdout" "s3cr3t-VERY" "$OUT"

# Check file contents
PERMS=$(stat -c '%a' "$WRITE_ENV" 2>/dev/null || stat -f '%Lp' "$WRITE_ENV" 2>/dev/null)
assert "file permissions are 600" "600" "$PERMS"

FILE_CONTENT=$(cat "$WRITE_ENV")
assert_contains "env file has client_id" "client_id=abc123def456" "$FILE_CONTENT"
assert_contains "env file has client_secret" "client_secret=s3cr3t-VERY-long-value-that-should-be-hidden-9876" "$FILE_CONTENT"

# ===========================================================================
echo ""
echo "=== 5. Write mode — json format ==="
# ===========================================================================
WRITE_JSON=$(mktemp "${TMPDIR:-/tmp}/vault-write-XXXXXX.json")
rm -f "$WRITE_JSON"
OUT=$("$VAULT_GET" customer/ciam/stg/qas-us/Application_Credentials/my_app \
  --fixture "$FIXTURE" --write "$WRITE_JSON" --format json 2>&1)
assert_contains "json write prints confirmation" "wrote 3 keys to" "$OUT"

JSON_CONTENT=$(cat "$WRITE_JSON")
assert_contains "json file has client_id" '"client_id"' "$JSON_CONTENT"
assert_contains "json file has client_secret value" "s3cr3t-VERY-long-value-that-should-be-hidden-9876" "$JSON_CONTENT"

# ===========================================================================
echo ""
echo "=== 6. Reveal mode — TTY gate (CRITICAL) ==="
# ===========================================================================
# 6a. Piped to cat — must fail with exit 2
set +e
OUT=$("$VAULT_GET" customer/ciam/stg/qas-us/Application_Credentials/my_app \
  --fixture "$FIXTURE" --reveal 2>&1 | cat)
EXIT_CODE=${PIPESTATUS[0]}
set -e
assert "reveal piped to cat exits 2" "2" "$EXIT_CODE"
assert_contains "reveal pipe error message" "interactive terminal" "$OUT"
assert_not_contains "no secret leaked through pipe" "s3cr3t-VERY" "$OUT"

# 6b. Captured in $() — must fail with exit 2
set +e
OUT=$("$VAULT_GET" customer/ciam/stg/qas-us/Application_Credentials/my_app \
  --fixture "$FIXTURE" --reveal 2>&1)
EXIT_CODE=$?
set -e
assert "reveal captured in \$() exits 2" "2" "$EXIT_CODE"
assert_contains "reveal capture error message" "interactive terminal" "$OUT"
assert_not_contains "no secret leaked through capture" "s3cr3t-VERY" "$OUT"

# 6c. Redirected to file — must fail with exit 2
TMPFILE=$(mktemp "${TMPDIR:-/tmp}/vault-reveal-XXXXXX")
set +e
"$VAULT_GET" customer/ciam/stg/qas-us/Application_Credentials/my_app \
  --fixture "$FIXTURE" --reveal > "$TMPFILE" 2>&1
EXIT_CODE=$?
set -e
REDIR_CONTENT=$(cat "$TMPFILE")
assert "reveal redirected to file exits 2" "2" "$EXIT_CODE"
assert_contains "reveal redirect error message" "interactive terminal" "$REDIR_CONTENT"
assert_not_contains "no secret leaked through redirect" "s3cr3t-VERY" "$REDIR_CONTENT"

# ===========================================================================
echo ""
echo "=== 7. Error cases ==="
# ===========================================================================
set +e
OUT=$("$VAULT_GET" 2>&1)
assert "no args shows error" "1" "$?"
set -e

set +e
OUT=$("$VAULT_GET" some/path --fixture "$FIXTURE" --field nonexistent 2>&1)
assert "missing field exits 1" "1" "$?"
assert_contains "missing field error" "not found" "$OUT"
set -e

# ===========================================================================
echo ""
echo "==========================================="
echo "Results: ${PASS}/${TOTAL} passed, ${FAIL} failed"
echo "==========================================="
[ "$FAIL" -eq 0 ] && exit 0 || exit 1
