#!/usr/bin/env bash
# vault-get — retrieve Vault KV v2 secrets with LLM-safe output modes.
# See skills/vault/SKILL.md for full documentation.
set -euo pipefail

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
usage() {
  cat >&2 <<'EOF'
Usage: vault-get <secret-path> [options]

  <secret-path>   Vault KV v2 path, e.g. customer/ciam/stg/qas-us/Application_Credentials/my_app

Options:
  --field NAME           Operate on one field (default: all fields in .data.data)
  --masked               (DEFAULT) Print per field: name, first4…last4, char length, sha256 fingerprint
  --clipboard FIELD      Copy FIELD's raw value to clipboard (macOS pbcopy); stdout prints confirmation only
  --write FILE           Write fields to FILE; stdout prints confirmation only
    --format env|json    Output format for --write (default: env)
  --reveal               Print full values (⛔ TTY-gated: refuses when piped/captured)
  --fixture FILE         Use FILE as mock JSON response (testing only)

Environment:
  VAULT_ADDR             Vault instance URL
  VAULT_USERNAME         Userpass username  } used for login when VAULT_TOKEN is unset
  VAULT_PASSWORD         Userpass password  }
  VAULT_TOKEN            Skip login; use this token directly
  VAULT_GET_FIXTURE      Path to mock JSON response (alternative to --fixture)
EOF
  exit 1
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
SECRET_PATH=""
MODE="masked"
FIELD=""
CLIPBOARD_FIELD=""
WRITE_FILE=""
WRITE_FORMAT="env"
FIXTURE_FILE="${VAULT_GET_FIXTURE:-}"

while [ $# -gt 0 ]; do
  case "$1" in
    --field)       FIELD="$2"; shift 2 ;;
    --masked)      MODE="masked"; shift ;;
    --clipboard)   MODE="clipboard"; CLIPBOARD_FIELD="$2"; shift 2 ;;
    --write)       MODE="write"; WRITE_FILE="$2"; shift 2 ;;
    --format)      WRITE_FORMAT="$2"; shift 2 ;;
    --reveal)      MODE="reveal"; shift ;;
    --fixture)     FIXTURE_FILE="$2"; shift 2 ;;
    --help|-h)     usage ;;
    -*)            echo "ERROR: unknown option: $1" >&2; usage ;;
    *)
      if [ -z "$SECRET_PATH" ]; then
        SECRET_PATH="$1"; shift
      else
        echo "ERROR: unexpected argument: $1" >&2; usage
      fi
      ;;
  esac
done

[ -z "$SECRET_PATH" ] && { echo "ERROR: secret-path is required" >&2; usage; }

# ---------------------------------------------------------------------------
# Fetch secret JSON
# ---------------------------------------------------------------------------
fetch_secret() {
  # Fixture mode (testing)
  if [ -n "$FIXTURE_FILE" ]; then
    cat "$FIXTURE_FILE"
    return 0
  fi

  # Real Vault call — need VAULT_ADDR
  if [ -z "${VAULT_ADDR:-}" ]; then
    echo "ERROR: VAULT_ADDR is not set" >&2; exit 1
  fi

  # Obtain token
  local token="${VAULT_TOKEN:-}"
  if [ -z "$token" ]; then
    if [ -z "${VAULT_USERNAME:-}" ] || [ -z "${VAULT_PASSWORD:-}" ]; then
      echo "ERROR: VAULT_TOKEN or VAULT_USERNAME+VAULT_PASSWORD required" >&2; exit 1
    fi
    local login_resp
    login_resp=$(curl -sf -X POST "${VAULT_ADDR}/v1/auth/userpass/login/${VAULT_USERNAME}" \
      -d "{\"password\": \"${VAULT_PASSWORD}\"}" 2>&1) || {
      echo "ERROR: login failed — check VAULT_USERNAME/VAULT_PASSWORD" >&2; exit 1
    }
    token=$(printf '%s' "$login_resp" | jq -r '.auth.client_token // empty')
    if [ -z "$token" ]; then
      echo "ERROR: login response missing auth.client_token" >&2; exit 1
    fi
  fi

  # Fetch
  local http_code body
  body=$(mktemp "${TMPDIR:-/tmp}/vault-get-body-XXXXXX")
  http_code=$(curl -s -o "$body" -w '%{http_code}' \
    -H "X-Vault-Token: ${token}" \
    "${VAULT_ADDR}/v1/${SECRET_PATH}")

  case "$http_code" in
    200) cat "$body"; rm -f "$body" ;;
    403)
      echo "ERROR: 403 Forbidden — no permission or wrong path (policy owned by app team)" >&2
      rm -f "$body"; exit 1 ;;
    404)
      echo "ERROR: 404 Not Found — check mount name and ensure path uses /data/ for KV v2 reads" >&2
      rm -f "$body"; exit 1 ;;
    *)
      echo "ERROR: HTTP ${http_code} from Vault" >&2
      cat "$body" >&2; rm -f "$body"; exit 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# Extract fields from response JSON
# ---------------------------------------------------------------------------
extract_fields() {
  local json="$1"
  if [ -n "$FIELD" ]; then
    local result
    result=$(printf '%s' "$json" | jq --arg f "$FIELD" '.data.data | to_entries | map(select(.key == $f))' 2>/dev/null) \
      || { echo "ERROR: could not parse .data.data from response" >&2; exit 1; }
    if [ "$(printf '%s' "$result" | jq 'length')" = "0" ]; then
      echo "ERROR: field '$FIELD' not found in secret" >&2; exit 1
    fi
    printf '%s' "$result"
  else
    printf '%s' "$json" | jq -e '.data.data | to_entries' 2>/dev/null \
      || { echo "ERROR: could not parse .data.data from response" >&2; exit 1; }
  fi
}

# ---------------------------------------------------------------------------
# Mode: masked (DEFAULT)
# ---------------------------------------------------------------------------
mode_masked() {
  local entries="$1"
  printf '%s' "$entries" | jq -r '.[] | @base64' | while IFS= read -r row; do
    local key val len first4 last4 fingerprint mask
    key=$(printf '%s' "$row" | base64 -d | jq -r '.key')
    val=$(printf '%s' "$row" | base64 -d | jq -r '.value // ""')
    len=${#val}
    if [ "$len" -le 8 ]; then
      mask="****"
    else
      first4="${val:0:4}"
      last4="${val: -4}"
      mask="${first4}…${last4}"
    fi
    fingerprint=$(printf '%s' "$val" | shasum -a 256 | cut -c1-12)
    printf '%-30s  %s  (%d chars)  sha256:%s\n' "$key" "$mask" "$len" "$fingerprint"
  done
}

# ---------------------------------------------------------------------------
# Mode: clipboard
# ---------------------------------------------------------------------------
mode_clipboard() {
  local entries="$1"
  local val len
  val=$(printf '%s' "$entries" | jq -r --arg f "$CLIPBOARD_FIELD" \
    '.[] | select(.key == $f) | .value // ""')
  if [ -z "$val" ] && [ "$(printf '%s' "$entries" | jq --arg f "$CLIPBOARD_FIELD" '[.[] | select(.key == $f)] | length')" = "0" ]; then
    echo "ERROR: field '${CLIPBOARD_FIELD}' not found" >&2; exit 1
  fi
  len=${#val}
  printf '%s' "$val" | pbcopy
  echo "copied ${CLIPBOARD_FIELD} (${len} chars) to clipboard"
}

# ---------------------------------------------------------------------------
# Mode: write
# ---------------------------------------------------------------------------
mode_write() {
  local entries="$1"

  # Create file with 0600 if it doesn't exist
  if [ ! -f "$WRITE_FILE" ]; then
    touch "$WRITE_FILE"
    chmod 0600 "$WRITE_FILE"
  fi

  local count
  count=$(printf '%s' "$entries" | jq 'length')

  case "$WRITE_FORMAT" in
    env)
      printf '%s' "$entries" | jq -r '.[] | "\(.key)=\(.value)"' >> "$WRITE_FILE"
      ;;
    json)
      local new_obj existing
      new_obj=$(printf '%s' "$entries" | jq 'from_entries')
      if [ -s "$WRITE_FILE" ]; then
        existing=$(cat "$WRITE_FILE")
        # Merge: existing + new (new wins)
        printf '%s' "$existing" | jq --argjson new "$new_obj" '. * $new' > "$WRITE_FILE"
      else
        printf '%s' "$new_obj" | jq '.' > "$WRITE_FILE"
      fi
      chmod 0600 "$WRITE_FILE"
      ;;
    *)
      echo "ERROR: --format must be 'env' or 'json'" >&2; exit 1
      ;;
  esac

  echo "wrote ${count} keys to ${WRITE_FILE}"
}

# ---------------------------------------------------------------------------
# Mode: reveal (⛔ TTY-GATED)
# ---------------------------------------------------------------------------
mode_reveal() {
  if [ ! -t 1 ]; then
    echo 'ERROR: --reveal requires an interactive terminal (refusing to print secrets into a pipe/agent context). Use --masked, --clipboard, or --write.' >&2
    exit 2
  fi

  local entries="$1"
  printf '%s' "$entries" | jq -r '.[] | "\(.key)=\(.value)"'
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
RESPONSE=$(fetch_secret)
ENTRIES=$(extract_fields "$RESPONSE")

case "$MODE" in
  masked)    mode_masked "$ENTRIES" ;;
  clipboard) mode_clipboard "$ENTRIES" ;;
  write)     mode_write "$ENTRIES" ;;
  reveal)    mode_reveal "$ENTRIES" ;;
esac
