# OS
.DS_Store

# Editor
.idea/
.vscode/
*.swp

# Notes / scratch
scratch/
*.log

# Python bytecode — every script here is run directly, so this appears the moment
# anything imports a sibling module. Regenerable, and audit.py counts it as an orphan.
__pycache__/
*.pyc

# Generated agent artifacts (regenerable — not source)
.agents/artifacts/
.agents/canvas/

# Rust build output (credentials skill) — compiled binary is regenerable
src/credentials/target/
skills/credentials/scripts/cred-run

# Go build output (flagship skill) — compiled binary is regenerable
skills/flagship/scripts/fs

# Vendored third-party diagram library (~4MB). Fetch it with the curl line in
# skills/canvas/SKILL.md; the canvas degrades to source text without it.
skills/canvas/assets/mermaid.min.js
